# Replace with your real preferred hostname. Placeholder domains do NOT enable SEO.
DOMAIN=pocket.example.com
# true enables public-page indexing only with a valid PUBLIC_ORIGIN (derived in Compose).
# Use false on staging even when staging has a real domain.
SEO_INDEXING_ENABLED=true
# Public verification tokens (not account passwords or API keys); optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
CACHE_TTL=600
ENABLE_BROWSER=false
DISABLE_YTDLP=false
DISABLE_HTML=false
DISABLE_BROWSER=false
RESOLVER_CONCURRENCY=3
MAX_MEDIA_BYTES=1073741824
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
METRICS_TOKEN=

# Default all-in-one setup. For GitHub Pages + Render, follow FREE_LAUNCH_GUIDE.md instead.
ENABLE_CROSS_ORIGIN=false
MAX_ACTIVE_DOWNLOADS=12
